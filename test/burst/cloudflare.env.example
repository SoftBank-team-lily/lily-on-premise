# cloudflare.env 로 복사해서 채운다. git 에 올리지 않는다
#
# Account API 토큰 권한 (대시보드 → Manage Account → Account API Tokens → Create)
#   - Account 전체: Cloudflare Tunnel Write
#   - Specified Domains (테스트 도메인 하나): DNS Write, Zone Read, SSL and Certificates Write
#
# 계정 ID, 존 ID: 대시보드에서 도메인 선택 → 오른쪽 아래 "API" 영역
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# 앱 주소는 https://{앱}.{이 도메인}
CLOUDFLARE_ZONE_NAME=lilycloud.kr
