# burst.env 로 복사해서 채운다. 버스팅 토큰이 들어가므로 git 에 올리지 않는다
BURST_ENABLED=true
# lily-builder 공개 주소 (/api/burst 만 열려 있다)
BURST_BUILDER_URL=http://builder.43.200.152.53.nip.io
# k3s Secret lily-system/lily-burst 의 BURST_API_TOKEN
BURST_API_TOKEN=
# 넘길 클라우드 Ingress
BURST_INGRESS_HOST=43.200.152.53
# 비워두면 {앱}.{CLOUDFLARE_ZONE_NAME}
BURST_PUBLIC_HOST=
BURST_LOCAL_LIMIT=4
BURST_SCALE_UP_AFTER_SECONDS=3
BURST_COOLDOWN_SECONDS=20
BURST_REPLICAS=2

# DB 터널 (lily-server 의 lily-tunnel 계정, RDS:5432 포워딩만)
DB_TUNNEL_SSH_HOST=43.200.152.53
# 컨테이너 안 경로. run-agent.sh 가 keys/ 를 /keys 로 마운트하고 /tmp/tunnel_key 로 복사한다
DB_TUNNEL_SSH_KEY=/tmp/tunnel_key
# RDS 엔드포인트 (terraform output)
DB_TUNNEL_REMOTE_HOST=
